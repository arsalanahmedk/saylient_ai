# Copy to .env and fill in. NEVER commit .env.
APP_ENV=development
APP_SECRET_KEY=change-me-long-random-string
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=14

DATABASE_URL=postgresql+psycopg://saylient:change-me@localhost:5432/saylient
REDIS_URL=redis://localhost:6379/0

# Application-level encryption key for stored message text (32 bytes, base64)
DATA_ENCRYPTION_KEY=change-me-base64-32-bytes

# LLM provider (Phase 2) — see docs/LLM_CHOICE.md for limits and caveats.
# Primary: Google Gemini Flash via Google AI Studio free tier (no card).
# Fallback: Groq free plan (gpt-oss-120b).
# Leave AI_PROVIDER empty or set it to "none" to run rule-based only.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# AI_MODEL defaults: gemini -> gemini-2.5-flash, groq -> openai/gpt-oss-120b.
# Get a key: Gemini https://aistudio.google.com (free, no card) · Groq https://console.groq.com
# Free-tier content may be used by the provider to improve its products:
# never send real client data through the free tier in production.
AI_TIMEOUT_SECONDS=20

# Internal inference service (never expose publicly)
INFERENCE_URL=http://localhost:8001
INFERENCE_TOKEN=change-me-internal-service-token
MODEL_VERSION=saylient-v0.1

CORS_ALLOWED_ORIGINS=http://localhost:3000
EXTENSION_ID=your-chrome-extension-id

SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SENTRY_DSN=
